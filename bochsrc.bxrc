# How much memory the emulation has
megs: 32

# Path to your compiled bootable floppy disk image
floppya: 1_44="out/main_floppy.img", status=inserted

# Boot from the floppy disk
boot: floppy

# Send log outputs to a file instead of clobbering the terminal
log: bochsout.txt

# Enable the built-in internal debugger GUI or text window
display_library: win32